{
  "name": "@mahendar8121/ts-npm-utils",
  "version": "1.1.0",
  "description": "TypeScript NPM package compiled to JavaScript with dual CommonJS/ES module support",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json && move dist\\cjs\\index.js dist\\cjs\\index.cjs",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "node test/index.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["typescript", "npm", "utils", "dual-package"],
  "author": "Your Name",
  "license": "ISC",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
